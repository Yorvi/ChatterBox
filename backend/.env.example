# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and never committed.

PORT=3000
NODE_ENV=development

# MySQL connection
DB_NAME=chatterbox
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Set to true for managed MySQL hosts that require TLS (e.g. PlanetScale)
DB_SSL=false

# Used to sign/verify JWTs - use a long random string in real environments
JWT_SECRET=change_this_secret

# Origin allowed to hit the API and open Socket.IO connections (the Angular dev server, etc.)
CLIENT_URL=http://localhost:4200
