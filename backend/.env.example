# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and never committed.

PORT=3000

# MySQL connection
DB_NAME=chatterbox
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Used to sign/verify JWTs - use a long random string in real environments
JWT_SECRET=change_this_secret

# Origin allowed to hit the API and open Socket.IO connections (the Angular dev server, etc.)
CLIENT_URL=http://localhost:4200
